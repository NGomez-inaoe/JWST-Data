          naxes: 1
          unit: [!unit/unit-1.0.0 pixel]
        transform: !transform/compose-1.3.0
          forward:
          - !transform/remap_axes-1.4.0
            inputs: [x0]
            mapping: [0, 0, 0]
            outputs: [x0, x1, x2]
          - !transform/concatenate-1.3.0
            forward:
            - !transform/concatenate-1.3.0
              forward:
              - !transform/constant-1.5.0
                dimensions: 1
                inputs: [x]
                outputs: [y]
                value: 53.15132142738709
              - !transform/constant-1.5.0
                dimensions: 1
                inputs: [x]
                outputs: [y]
                value: -27.819154703415588
              inputs: [x0, x1]
              outputs: [y0, y1]
            - !transform/tabular-1.3.0
              bounds_error: false
              inputs: [x]
              lookup_table: &id002 !core/ndarray-1.1.0
                source: 0
                datatype: float64
                byteorder: little
                shape: [1358]
              method: linear
              outputs: [y]
              points:
              - &id001 !core/ndarray-1.1.0
                source: 1
                datatype: float64
                byteorder: little
                shape: [1358]
            inputs: [x0, x1, x]
            outputs: [y0, y1, y]
          inputs: [x0]
          inverse: !transform/compose-1.3.0
            forward:
            - !transform/remap_axes-1.4.0
              inputs: [x0, x1, x2]
              mapping: [2]
              outputs: [x0]
            - !transform/tabular-1.3.0
              bounds_error: false
              fill_value: .nan
              inputs: [x]
              lookup_table: *id001
              method: linear
              outputs: [y]
              points:
              - *id002
            inputs: [x0, x1, x2]
            outputs: [y]
          name: pixel_to_world
          outputs: [y0, y1, y]
      - !<tag:stsci.edu:gwcs/step-1.3.0>
        frame: !<tag:stsci.edu:gwcs/composite_frame-1.0.0>
          frames:
          - !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
